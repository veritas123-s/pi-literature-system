{
  "name": "pi-literature-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "cloud": "tsx src/cloud/main.ts",
    "worker": "tsx src/worker/main.ts",
    "doctor": "tsx src/worker/cli.ts doctor",
    "research": "tsx src/worker/cli.ts run",
    "probe": "tsx scripts/live-search.ts",
    "web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.0.2",
    "@earendil-works/pi-ai": "1.0.2",
    "@fastify/cors": "11.1.0",
    "@fastify/multipart": "9.3.0",
    "fastify": "5.6.2",
    "typebox": "1.3.27",
    "fast-xml-parser": "5.3.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "docx": "9.5.1",
    "pdf-lib": "1.17.1",
    "@pdf-lib/fontkit": "1.1.1",
    "@citation-js/core": "0.7.18",
    "@citation-js/plugin-bibtex": "0.7.18"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3",
    "tsx": "4.20.6",
    "vite": "7.1.12"
  }
}
